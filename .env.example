# Environment variables — barbershop platform
# Copy to `.env.local` (gitignored) per app, or export in CI.

# --- Database (MySQL) ---
# Used by route handlers (apps/web) and the worker.
DATABASE_URL=mysql://user:password@localhost:3306/barberia?allowPublicKeyRetrieval=true

# --- Auth.js v5 (apps/web) ---
# Required for JWT sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Required when self-hosting outside Vercel (trusts the request host).
AUTH_TRUST_HOST=true
# Public origin for callbacks in production.
AUTH_URL=http://localhost:3000

# Google OAuth — client must provide a Google Cloud project + consent screen
# credentials (open question in design.md). Auth.js disables the Google
# provider until BOTH variables are present.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
