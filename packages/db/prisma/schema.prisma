// Prisma schema for the barbershop platform (Postgres).
//
// Conventions:
// - Tables keep the model name (PascalCase, quoted) so raw SQL matches the
//   design's migration statements (e.g. "Appointment").
// - Columns are snake_case via @map, matching the btree_gist exclusion
//   constraint written in raw SQL (barber_id, starts_at, ends_at).
// - Every tenant-scoped entity carries `barbershopId`; application queries
//   MUST inject `{ barbershopId }` via lib/tenant.ts scope().

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  BARBER
  BARBERSHOP_ADMIN
}

enum ConfirmationMode {
  AUTO
  MANUAL
}

enum LateCancelPolicy {
  REJECT
  ALLOW
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
}

enum NotificationType {
  CONFIRMATION
  REMINDER
  RESCHEDULE
  CANCELLATION
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model Barbershop {
  id                    String           @id @default(uuid())
  slug                  String           @unique
  name                  String
  timezone              String
  slotGranularity       Int              @default(30) @map("slot_granularity")
  confirmationMode      ConfirmationMode @default(AUTO) @map("confirmation_mode")
  freeCancelWindowHours Int              @default(24) @map("free_cancel_window_hours")
  lateCancelPolicy      LateCancelPolicy @default(REJECT) @map("late_cancel_policy")
  rescheduleWindowHours Int              @default(24) @map("reschedule_window_hours")
  reminderLeadHours     Int              @default(24) @map("reminder_lead_hours")
  pixProvider           String?          @map("pix_provider")
  pixCredentials        Json?            @map("pix_credentials")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  users        User[]
  services     Service[]
  barbers      Barber[]
  appointments Appointment[]

  @@map("Barbershop")
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String?   @map("password_hash")
  name                  String?
  phone                 String?
  role                  Role      @default(CLIENT)
  barbershopId          String?   @map("barbershop_id")
  consentAcceptedAt     DateTime? @map("consent_accepted_at") @db.Timestamptz(3)
  consentPolicyVersion  String?   @map("consent_policy_version")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop    Barbershop?   @relation(fields: [barbershopId], references: [id])
  barberProfile Barber?
  appointments  Appointment[]

  @@map("User")
}

model Barber {
  id           String   @id @default(uuid())
  barbershopId String   @map("barbershop_id")
  userId       String   @unique @map("user_id")
  specialties  String[]
  bio          String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop  Barbershop         @relation(fields: [barbershopId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  services    BarberService[]
  schedules   Schedule[]
  exceptions  ScheduleException[]
  appointments Appointment[]

  @@map("Barber")
}

model Service {
  id              String   @id @default(uuid())
  barbershopId    String   @map("barbershop_id")
  name            String
  description     String?
  priceBRL        Decimal  @map("price_brl") @db.Decimal(10, 2)
  durationMinutes Int      @map("duration_minutes")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop     Barbershop       @relation(fields: [barbershopId], references: [id])
  barberServices BarberService[]
  appointments   Appointment[]

  @@map("Service")
}

model BarberService {
  barberId  String @map("barber_id")
  serviceId String @map("service_id")

  barber  Barber  @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([barberId, serviceId])
  @@map("BarberService")
}

model Schedule {
  id        String @id @default(uuid())
  barberId  String @map("barber_id")
  dayOfWeek Int    @map("day_of_week") // 1=Monday .. 7=Sunday
  startTime String @map("start_time") // "HH:MM" 24h
  endTime   String @map("end_time") // "HH:MM" 24h

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dayOfWeek])
  @@map("Schedule")
}

model ScheduleException {
  id        String   @id @default(uuid())
  barberId  String   @map("barber_id")
  date      DateTime @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  reason    String?

  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, date])
  @@map("ScheduleException")
}

model Appointment {
  id                String            @id @default(uuid())
  barbershopId      String            @map("barbershop_id")
  barberId          String            @map("barber_id")
  clientId          String            @map("client_id")
  serviceId         String            @map("service_id")
  startsAt          DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime          @map("ends_at") @db.Timestamptz(3)
  status            AppointmentStatus @default(PENDING)
  priceSnapshot     Decimal           @map("price_snapshot") @db.Decimal(10, 2)
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  providerPaymentId String?           @map("provider_payment_id")
  noShowAt          DateTime?         @map("no_show_at") @db.Timestamptz(3)
  cancelReason      String?           @map("cancel_reason")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  barbershop   Barbershop           @relation(fields: [barbershopId], references: [id])
  barber       Barber               @relation(fields: [barberId], references: [id])
  client       User                 @relation(fields: [clientId], references: [id])
  service      Service              @relation(fields: [serviceId], references: [id])
  notifications EmailNotification[]
  paymentEvents PaymentWebhookEvent[]

  @@index([barbershopId])
  @@index([barberId, startsAt])
  @@map("Appointment")
}

model EmailNotification {
  id            String             @id @default(uuid())
  appointmentId String             @map("appointment_id")
  type          NotificationType
  status        NotificationStatus @default(QUEUED)
  retryCount    Int                @default(0) @map("retry_count")
  nextAttemptAt DateTime           @map("next_attempt_at") @db.Timestamptz(3)
  payload       Json?
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("EmailNotification")
}

model PaymentWebhookEvent {
  id                String   @id @default(uuid())
  providerEventId   String   @unique @map("provider_event_id")
  providerPaymentId String?  @map("provider_payment_id")
  appointmentId     String?  @map("appointment_id")
  payload           Json
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("PaymentWebhookEvent")
}
